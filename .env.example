# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL is required. `docker compose up -d` starts the matching local service.
DATABASE_URL="postgresql://issueswipe:issueswipe-local-dev@localhost:5432/issueswipe?schema=public"

# ─── GitHub OAuth App ────────────────────────────────────────────────────────
# Create one at: https://github.com/settings/developers
# Set "Authorization callback URL" to: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# ─── GitHub Personal Access Token (for Issue Sync) ───────────────────────────
# Generate at: https://github.com/settings/tokens
# Required scopes: public_repo, read:user
# Leave blank to use the built-in simulation mode
GITHUB_PERSONAL_ACCESS_TOKEN=""

# ─── Firebase client (required only when NEXT_PUBLIC_DEV_MODE is "false") ────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Session Security ─────────────────────────────────────────────────────────
# Generate a strong random secret for JWT signing
JWT_SECRET="replace-with-a-long-random-secret-string"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Developer Mode ───────────────────────────────────────────────────────────
# Set to "true" to bypass GitHub OAuth and log in with a mock developer account
# Useful for local development without a GitHub OAuth App
NEXT_PUBLIC_DEV_MODE="true"
